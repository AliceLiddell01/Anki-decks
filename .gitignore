# Метаданные Windows Mark-of-the-Web, которые могут появляться как файлы в WSL/Linux
*:Zone.Identifier

# Артефакты сборки корневого Cargo workspace: Rust-проверки запускаются из корня
# репозитория, поэтому build output принадлежит корневому `target/`.
/target

# В Git попадает только verified-only canonical corpus поддерживаемых domains.
# Candidate и quarantine manifests/bytes лежат в локальном runtime overlay.
/.asset-store/*
!/.asset-store/kanji/
!/.asset-store/pitch-accent/
/.asset-store/kanji/*
!/.asset-store/kanji/.owner.json
!/.asset-store/kanji/manifest.json
!/.asset-store/kanji/assets/
/.asset-store/kanji/assets/*
!/.asset-store/kanji/assets/gif/
!/.asset-store/kanji/assets/png/
/.asset-store/kanji/assets/gif/*
!/.asset-store/kanji/assets/gif/*.gif
# Gitignore сопоставляет пути: каталоги с разрешённым суффиксом тоже запрещены.
/.asset-store/kanji/assets/gif/*.gif/
/.asset-store/kanji/assets/png/*
!/.asset-store/kanji/assets/png/*.png
/.asset-store/kanji/assets/png/*.png/
/.asset-store/kanji/.runtime/
/.asset-store/kanji/.lock
/.asset-store/kanji/.tmp/
/.asset-store/pitch-accent/*
!/.asset-store/pitch-accent/.owner.json
!/.asset-store/pitch-accent/manifest.json
!/.asset-store/pitch-accent/assets/
/.asset-store/pitch-accent/assets/*
!/.asset-store/pitch-accent/assets/png/
/.asset-store/pitch-accent/assets/png/*
!/.asset-store/pitch-accent/assets/png/*.png
/.asset-store/pitch-accent/assets/png/*.png/
/.asset-store/pitch-accent/.runtime/
/.asset-store/pitch-accent/.lock
/.asset-store/pitch-accent/.tmp/

# Каталог статического отчёта `anki-repo visual-report`: это результат единичного
# прогона (сотни файлов превью и копий media), а не данные репозитория. Каталог
# отчёта обязан лежать вне `decks/**` и не попадать в коммит; эти имена
# зафиксированы как соглашение, чтобы прогон рядом с репозиторием не всплывал в
# `git status`.
/visual-report/
/report/

# Repository-local рабочие артефакты агента — например Markdown-источник body
# текущего PR (`/.codex/local/pr/<task>/body.md`). Это не публикуемый контракт
# репозитория и не tracked: процедуру владеет `.agents/skills/anki-git-workflow/`.
/.codex/local/

/.anki-repo/review/

# Локальная база адаптивной памяти code review: SQLite-история, backup и
# экспорты learning. Это рабочие данные конкретного клона, а не контракт
# репозитория, поэтому каталог игнорируется целиком. Утверждённые policy
# artifacts версионируются отдельно и попадают в Git только вручную.
/.anki-repo/learning/
