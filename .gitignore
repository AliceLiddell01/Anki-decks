# Windows Mark-of-the-Web metadata that may appear as literal files in WSL/Linux
*:Zone.Identifier

# Артефакты сборки корневого Cargo workspace: Rust-проверки запускаются из корня
# репозитория, поэтому build output принадлежит корневому `target/`.
/target

# Canonical verified kanji corpus сохраняется в Git. Из runtime state остаются
# локальными только lock и незавершённая временная публикация.
/.asset-store/*
!/.asset-store/kanji/
/.asset-store/kanji/*
!/.asset-store/kanji/.owner.json
!/.asset-store/kanji/manifest.json
!/.asset-store/kanji/assets/
/.asset-store/kanji/assets/*
!/.asset-store/kanji/assets/*.gif
!/.asset-store/kanji/assets/*.png
/.asset-store/kanji/.lock
/.asset-store/kanji/.tmp/

# Каталог статического отчёта `anki-repo visual-report`: это результат единичного
# прогона (сотни файлов превью и копий media), а не данные репозитория. Каталог
# отчёта обязан лежать вне `decks/**` и не попадать в коммит; эти имена
# зафиксированы как соглашение, чтобы прогон рядом с репозиторием не всплывал в
# `git status`.
/visual-report/
/report/

# Repository-local рабочие артефакты агента — например Markdown-источник body
# текущего PR (`/.codex/local/pr/<task>/body.md`). Это не публикуемый контракт
# репозитория и не tracked: процедуру владеет `.agents/skills/anki-git-workflow/`.
/.codex/local/
